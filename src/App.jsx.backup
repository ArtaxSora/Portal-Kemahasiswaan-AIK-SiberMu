                <div className="w-12 h-12 bg-amber-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">2</div>
                <h3 className="font-bold text-slate-900 mb-2">Pengabdian & KKN PJJ</h3>
                <p className="text-xs text-slate-600 leading-relaxed">
                  KKN Pendidikan Jarak Jauh memadukan keahlian digital mahasiswa untuk memberdayakan UMKM dan ranting Muhammadiyah.
                </p>
              </div>

              <div className="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center">
                <div className="w-12 h-12 bg-emerald-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">3</div>
                <h3 className="font-bold text-slate-900 mb-2">Kepemimpinan Berkemajuan</h3>
                <p className="text-xs text-slate-600 leading-relaxed">
                  Organisasi mahasiswa dilandasi nilai musyawarah mufakat dan semangat berlomba-lomba dalam kebaikan menghadapi era digital.
                </p>
              </div>
            </div>
          </section>

          {/* Interactive Finder */}
          <section id="layanan" className="bg-gradient-to-br from-blue-900 via-slate-900 to-slate-950 text-white p-8 sm:p-12 rounded-3xl shadow-xl">
            <div className="max-w-2xl mb-8">
              <span className="text-xs uppercase font-bold tracking-widest text-amber-400">Interactive Finder</span>
              <h2 className="text-2xl sm:text-3xl font-extrabold mt-1 mb-2">Temukan Jalur Aktivitasmu</h2>
              <p className="text-slate-300 text-sm">Pilih minat utama untuk melihat rekomendasi UKM dan program AIK yang paling pas.</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div>
                <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Minat Utama:</label>
                <div className="grid grid-cols-2 gap-2">
                  <button 
                    onClick={() => setActiveQuiz({ interest: 'tech' })} 
                    className={`py-3 px-4 rounded-xl text-xs font-semibold border text-left transition-all ${activeQuiz.interest === 'tech' ? 'bg-amber-500 text-slate-950 border-amber-400 font-bold' : 'bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800'}`}
                  >
                    💻 Teknologi & Coding
                  </button>
                  <button 
                    onClick={() => setActiveQuiz({ interest: 'social' })} 
                    className={`py-3 px-4 rounded-xl text-xs font-semibold border text-left transition-all ${activeQuiz.interest === 'social' ? 'bg-amber-500 text-slate-950 border-amber-400 font-bold' : 'bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800'}`}
                  >
                    🤝 Organisasi & Sosial
                  </button>
                  <button 
                    onClick={() => setActiveQuiz({ interest: 'business' })} 
                    className={`py-3 px-4 rounded-xl text-xs font-semibold border text-left transition-all ${activeQuiz.interest === 'business' ? 'bg-amber-500 text-slate-950 border-amber-400 font-bold' : 'bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800'}`}
                  >
                    📈 Bisnis & Startup
                  </button>
                  <button 
                    onClick={() => setActiveQuiz({ interest: 'dakwah' })} 
                    className={`py-3 px-4 rounded-xl text-xs font-semibold border text-left transition-all ${activeQuiz.interest === 'dakwah' ? 'bg-amber-500 text-slate-950 border-amber-400 font-bold' : 'bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800'}`}
                  >
                    🕌 Dakwah & Kajian
                  </button>
                </div>
              </div>

              <div className="bg-slate-900/90 p-6 rounded-2xl border border-slate-800 flex flex-col justify-between">
                <div>
                  <div className="text-xs uppercase font-bold text-amber-400 mb-1">Rekomendasi:</div>
                  <h3 className="text-lg font-bold text-white mb-2">
                    {activeQuiz.interest === 'tech' && 'UKM Cyber Security & Riset Siber'}
                    {activeQuiz.interest === 'social' && 'BEM SiberMu & DPM'}
                    {activeQuiz.interest === 'business' && 'UKM Bisnis Digital & Startup'}
                    {activeQuiz.interest === 'dakwah' && 'Kajian AIK & Dakwah Kreatif'}
                  </h3>
                  <p className="text-xs text-slate-300 leading-relaxed mb-4">
                    {activeQuiz.interest === 'tech' && 'Cocok untuk mahasiswa yang ingin menguasai penetesting, secure coding, dan etika digital Islami.'}
                    {activeQuiz.interest === 'social' && 'Wadah kepemimpinan nasional dan manajemen advokasi mahasiswa PJJ lintas provinsi.'}
                    {activeQuiz.interest === 'business' && 'Mengembangkan jiwa entrepreneurship digital, e-commerce, dan manajemen finansial syariah.'}
                    {activeQuiz.interest === 'dakwah' && 'Menggabungkan semangat spiritualitas dalam menyebarkan konten Islam rahmatan lil \'alamin.'}
                  </p>
                </div>
                <a href="#pendaftaran" className="inline-flex items-center gap-2 text-xs font-bold text-amber-400 hover:underline">
                  <span>Gabung Program</span>
                  <ArrowUpRight className="w-4 h-4" />
                </a>
              </div>
            </div>
          </section>

          {/* CTA PMB */}
          <section id="pendaftaran" className="bg-gradient-to-r from-amber-500 to-amber-600 rounded-3xl p-8 sm:p-12 text-slate-950 shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
            <div className="space-y-3 max-w-xl">
              <span className="bg-slate-950 text-amber-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">PMB SiberMu 2026</span>
              <h2 className="text-3xl sm:text-4xl font-extrabold tracking-tight">Siap Menjadi Bagian Dari Masa Depan?</h2>
              <p className="text-slate-900 text-sm sm:text-base font-medium">
                Kuliah fleksibel, berkualitas, terjangkau (mulai Rp1 juta/semester), didukung penuh oleh jaringan Persyarikatan Muhammadiyah.
              </p>
            </div>
            <div className="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
              <a href="https://sibermu.ac.id/pendaftaran" target="_blank" rel="noreferrer" className="px-8 py-4 bg-slate-950 hover:bg-slate-900 text-white font-bold rounded-xl text-center shadow-lg transition-all text-sm uppercase tracking-wider">
                Daftar Online
              </a>
              <a href="https://sibermu.ac.id" target="_blank" rel="noreferrer" className="px-6 py-4 bg-white/90 hover:bg-white text-slate-900 font-bold rounded-xl text-center transition-all text-sm uppercase tracking-wider">
                Info Lebih Lanjut
              </a>
            </div>
          </section>

        </div>
      </main>

      {/* Footer */}
      <footer className="bg-slate-950 text-slate-400 py-16 border-t border-slate-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          
          <div className="space-y-4">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-lg bg-amber-500 flex items-center justify-center text-slate-950 font-bold">S</div>
              <span className="font-bold text-white text-lg">SiberMu</span>
            </div>
            <p className="text-xs text-slate-400 leading-relaxed">
              Perguruan Tinggi Siber pertama di lingkungan PTMA dengan modus tunggal Pendidikan Jarak Jauh (PJJ).
            </p>
            <div className="text-xs text-slate-500">© 2026 SiberMu. Hak Cipta Dilindungi.</div>
          </div>

          <div>
            <h4 className="font-bold text-white text-sm mb-4 tracking-wider uppercase">Kampus Pusat</h4>
            <ul className="space-y-3 text-xs text-slate-400">
              <li className="flex items-start gap-2">
                <MapPin className="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span>Jl. HOS Cokroaminoto No. 17, Yogyakarta, DIY 55253</span>
              </li>
              <li className="flex items-center gap-2">
                <Mail className="w-4 h-4 text-amber-500 shrink-0" />
                <span>humas@sibermu.ac.id</span>
              </li>
              <li className="flex items-center gap-2">
                <Globe className="w-4 h-4 text-amber-500 shrink-0" />
                <span>https://sibermu.ac.id</span>
              </li>
            </ul>
          </div>

          <div>
            <h4 className="font-bold text-white text-sm mb-4 tracking-wider uppercase">Menu Utama</h4>
            <ul className="space-y-2 text-xs">
              <li><a href="#kemahasiswaan" className="hover:text-amber-400 transition-colors">Kemahasiswaan</a></li>
              <li><a href="#aik" className="hover:text-amber-400 transition-colors">Al-Islam & Kemuhammadiyahan</a></li>
              <li><a href="#sinergi" className="hover:text-amber-400 transition-colors">Sinergi Digital</a></li>
              <li><a href="#layanan" className="hover:text-amber-400 transition-colors">Program & Layanan</a></li>
              <li><a href="#pendaftaran" className="hover:text-amber-400 transition-colors">Pendaftaran</a></li>
            </ul>
          </div>

          <div>
            <h4 className="font-bold text-white text-sm mb-4 tracking-wider uppercase">Program Studi</h4>
            <ul className="space-y-2 text-xs">
              <li className="text-slate-300">• S1 Informatika PJJ</li>
              <li className="text-slate-300">• S1 Sistem Informasi PJJ</li>
              <li className="text-slate-300">• S1 Administrasi Kesehatan PJJ</li>
              <li className="text-slate-300">• S1 Akuntansi PJJ</li>
              <li className="text-slate-300">• S1 Manajemen PJJ</li>
              <li className="text-slate-300">• S1 Hukum PJJ</li>
            </ul>
          </div>

        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-slate-900 text-center text-xs text-slate-500">
          Landing Page Lomba Kemahasiswaan & AIK SiberMu • Dibangun dengan React.js, Tailwind CSS, dan Lucide Icons
        </div>
      </footer>

    </div>
  );
}
